{
  "name": "time-letter",
  "productName": "时光信笺",
  "version": "2.0.1",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "electron/main-loader.js",
  "scripts": {
    "electron:serve": "npm run bundle:main && npm run compile && concurrently -n \"VITE,NODE\" -c \"blue,green\" -k \"npm run vite:start\" \"npm run electron:start\"",
    "electron:start": "wait-on http://localhost:5173 && node scripts/dev-codepage.js && cross-env NODE_ENV=development electron .",
    "electron:build": "npm run check:build-env && vite build && npm run bundle:main && npm run compile && electron-builder",
    "electron:build:win": "npm run electron:build -- --win",
    "electron:build:linux": "npm run electron:build -- --linux",
    "electron:build:mac": "npm run electron:build -- --mac",
    "compile": "node scripts/compile.js",
    "check:build-env": "node scripts/check-build-env.js",
    "bundle:main": "node scripts/bundle-main.js",
    "vite:start": "vite",
    "vite:build": "vite build",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.7",
    "adm-zip": "^0.5.17",
    "archiver": "^7.0.1",
    "bytenode": "^1.5.7",
    "chokidar": "^4.0.3",
    "electron-localshortcut": "^3.2.1",
    "electron-updater": "^6.8.11",
    "electron-win-state": "^1.1.22",
    "element-plus": "^2.10.5",
    "exif": "^0.6.0",
    "exiftool-vendored": "^35.21.0",
    "glob": "^13.0.6",
    "i18next": "^26.4.2",
    "lodash": "^4.17.21",
    "normalize.css": "^8.0.1",
    "p-limit": "^6.2.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "sharp": "^0.34.3",
    "vue": "^3.4.15",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.2.5",
    "vue3-lazyload": "^0.3.8",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "^20.11.10",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.5.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "electron-builder-encryptor": "^2.3.3",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "nodemon": "^3.1.0",
    "npm-run-all2": "^6.1.1",
    "sass": "^1.89.2",
    "terser": "^5.49.0",
    "typescript": "~5.3.0",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^5.0.11",
    "vite-svg-loader": "^5.1.3",
    "vue-tsc": "^1.8.27",
    "wait-on": "^8.0.5"
  }
}
