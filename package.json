{
  "name": "time-letter",
  "productName": "时光信笺",
  "version": "2.0.0",
  "private": true,
  "main": "electron/main-loader.js",
  "scripts": {
    "electron:serve": "concurrently -n \"VITE,NODE\" -c \"blue,green\" -k \"npm run vite:start\" \"npm run electron:start\"",
    "electron:start": "wait-on http://localhost:5173 && chcp 65001 && cross-env NODE_ENV=development electron .",
    "electron:build": "vite build && electron-builder",
    "compile": "node scripts/compile.js",
    "vite:start": "vite",
    "vite:build": "vite build",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "adm-zip": "^0.5.17",
    "aeo-image": "^1.2.0",
    "bytenode": "^1.5.7",
    "chokidar": "^4.0.3",
    "electron-localshortcut": "^3.2.1",
    "electron-win-state": "^1.1.22",
    "element-plus": "^2.10.5",
    "exif": "^0.6.0",
    "exifr": "^7.1.3",
    "exifreader": "^4.41.0",
    "exiftool-vendored": "^35.21.0",
    "fontkit": "^2.0.4",
    "glob": "^13.0.6",
    "lodash": "^4.17.21",
    "normalize.css": "^8.0.1",
    "p-limit": "^6.2.0",
    "piexifjs": "^1.0.6",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "piscina": "^5.0.0",
    "sharp": "^0.34.3",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5",
    "vue3-lazyload": "^0.3.8"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "^20.11.10",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.5.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "nodemon": "^3.1.0",
    "npm-run-all2": "^6.1.1",
    "sass": "^1.89.2",
    "typescript": "~5.3.0",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^5.0.11",
    "vue-tsc": "^1.8.27",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.electron.app",
    "directories": {
      "buildResources": "assets",
      "output": "electron_dist"
    },
    "nsis": {
      "oneClick": false,
      "language": "2052",
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/resources/favicon.ico",
      "uninstallerIcon": "electron/resources/favicon.ico"
    },
    "win": {
      "icon": "electron/resources/favicon.png",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/resources/resources",
      "!electron/resources/fonts",
      "!electron/**/*.js",
      "electron/main-loader.js",
      "electron/preload/index-loader.js",
      "electron/thread/worker-loader.js"
    ],
    "extraResources": [
      {
        "from": "electron/resources/resources",
        "to": "./resources"
      },
      {
        "from": "electron/resources/fonts",
        "to": "./fonts"
      }
    ]
  }
}
